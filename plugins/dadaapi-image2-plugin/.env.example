# Required.
IMAGE2_API_KEY=

# Optional. Defaults to https://dadaapi.com.
IMAGE2_BASE_URL=https://dadaapi.com

# Optional. Defaults to gpt-image-2.
IMAGE2_MODEL=gpt-image-2

# Optional. Defaults to ./assets inside this MCP server directory.
IMAGE2_DEFAULT_OUTPUT_DIR=~/.codex/mcp/dadaapi-image2-plugin/assets

# Optional. API generation/edit timeout in milliseconds. Defaults to 300000 (5 minutes).
IMAGE2_REQUEST_TIMEOUT_MS=300000

# Optional. Result URL download timeout in milliseconds. Defaults to 60000 (1 minute).
IMAGE2_DOWNLOAD_TIMEOUT_MS=60000

# Optional. Maximum bytes allowed for each saved output. Defaults to 33554432 (32 MiB).
IMAGE2_MAX_OUTPUT_BYTES=33554432

# Optional. Used only by element extraction fallback on Windows or custom Python installs.
# IMAGE2_PYTHON=python
